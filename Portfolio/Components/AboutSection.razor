@inject IJSRuntime JS

<section class="sec hero" id="about">
    <div class="hero-meta">
        <span><span class="dot">●</span> Prague, Czech Republic</span>
        <span>·</span>
        <span><a href="mailto:jan.mesarc@outlook.com">jan.mesarc@outlook.com</a></span>
        <span>·</span>
        <span class="available"><span class="pulse"></span>Open to collaborations · Q3 2026</span>
    </div>

    <h1 class="display reveal">
        Jan Mesarc<br />
        <span class="last">— builds games.</span>
    </h1>

    <p class="hero-tag reveal">
        Game developer with 5+ years shipping titles in <b>Unreal Engine</b> and <b>Godot</b>.
        Before games: web apps, mobile, and backend systems across <b>.NET</b>, <b>ASP.NET</b>, and <b>Azure</b>.
        Currently at <b>Flying Rat Studio</b>, working on gameplay and networking systems.
    </p>

    <div class="cta-row reveal">
        <a href="/#projects" class="btn btn-primary"
           @onclick='() => ScrollTo("projects")' @onclick:preventDefault>
            View shipped titles <span class="arrow">↓</span>
        </a>
        <a href="mailto:jan.mesarc@outlook.com" class="btn">
            Get in touch <span class="arrow">→</span>
        </a>
    </div>

    <div class="hero-stats reveal">
        <div>
            <div class="n">5<span class="unit">+ yrs</span></div>
            <div class="l">Game development</div>
        </div>
        <div>
            <div class="n">6<span class="unit">titles</span></div>
            <div class="l">Shipped, professional</div>
        </div>
        <div>
            <div class="n">10<span class="unit">+ yrs</span></div>
            <div class="l">Software engineering</div>
        </div>
    </div>
</section>

@code {
    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("BlazorScrollToId", id);
    }
}
