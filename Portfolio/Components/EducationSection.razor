<section class="sec" id="education">
    <div class="sec-marker">
        <span class="num">04</span>
        <span>Education</span>
        <span class="rule"></span>
        <span class="count">@Entries.Length entries</span>
    </div>

    <div class="edu-list">
        @foreach (var e in Entries)
        {
            <div class="edu reveal">
                <div class="when">@e.When</div>
                <div>
                    <h3>@e.School</h3>
                    <div class="deg">@e.Degree</div>
                    <p>@e.Desc</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record EduEntry(string When, string School, string Degree, string Desc);

    private static readonly EduEntry[] Entries =
    {
        new("2017 → 2019",
            "University of Pardubice",
            "Master's, information technology",
            "Advanced data structures, algorithms and design patterns. My thesis was a cross-platform mobile app for smart homes. I also taught intro to C and C# here for two years."),
        new("2014 → 2017",
            "University of Pardubice",
            "Bachelor's, information technology",
            "Java, C, C++ and C#, plus my first contact with game development in Unity. My thesis was a multi-platform Unity3D game."),
        new("2010 → 2014",
            "VOŠ a SŠT Česká Třebová",
            "Electrical engineering",
            "Cisco CCNA modules 1 to 3, networking and operating systems. Where I first got my hands on real hardware."),
    };
}
