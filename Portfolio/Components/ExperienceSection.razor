<section class="sec" id="experience">
    <div class="sec-marker">
        <span class="num">03</span>
        <span>Experience</span>
        <span class="rule"></span>
        <span class="count">@Entries.Length roles</span>
    </div>

    <div class="xp-list">
        @foreach (var e in Entries)
        {
            <div class="xp reveal">
                @* Spaces live inside C# strings: Blazor trims whitespace next to code blocks. *@
                <div class="when">
                    @($"{e.From} → ")@if (e.To is null)
                    {
                        <span class="now">now</span>
                    }
                    else
                    {
                        @e.To
                    }
                </div>
                <div class="role">
                    <h3>@e.Role</h3>
                    <div class="co">
                        @if (!string.IsNullOrEmpty(e.Href))
                        {
                            <a href="@e.Href" target="_blank" rel="noopener">@e.Company ↗</a>
                        }
                        else
                        {
                            @e.Company
                        }
                    </div>
                    <p class="desc">@e.Desc</p>
                    <div class="tags">
                        @foreach (var t in e.Tags)
                        {
                            <span class="tag">@t</span>
                        }
                    </div>
                    @if (e.Credits is not null)
                    {
                        <p class="credits">
                            @("Shipped from this role: ")
                            @foreach (var c in e.Credits)
                            {
                                <b>@c.Title</b>@($", {c.Detail}. ")
                            }
                        </p>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Credit(string Title, string Detail);

    // To = null means the role is current and renders as "now".
    private record Entry(
        string From,
