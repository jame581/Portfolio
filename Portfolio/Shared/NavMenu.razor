@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@implements IAsyncDisposable
@using Portfolio.Services

<aside class="sidebar">
    <a class="sb-brand" href="/#about" @onclick="GoHome" @onclick:preventDefault>
        <img class="sb-avatar" src="assets/profile1.jpg" alt="Jan Mesarc" />
        <div>
            <div class="sb-name">Jan Mesarc</div>
            <div class="sb-role">Game Developer</div>
        </div>
    </a>

    <div class="sb-section-label">// Sections</div>
    <nav class="sb-nav">
        @foreach (var item in Sections)
        {
            <a href="/#@item.Id"
               class="@(IsHomeRoute && activeSection == item.Id ? "active" : null)"
               @onclick="() => GoSection(item.Id)" @onclick:preventDefault>
                <span class="idx">@item.Idx</span>
                <span>@item.Label</span>
                <span class="arrow">→</span>
            </a>
        }
    </nav>

    <div class="sb-section-label">// More</div>
    <nav class="sb-nav">
        <NavLink href="fetchgithubdata" Match="NavLinkMatch.All" ActiveClass="active">
            <span class="idx">07</span>
            <span>Public Repositories</span>
            <span class="arrow">→</span>
        </NavLink>
    </nav>

    <div class="sb-foot">
        <div class="sb-socials">
            <a href="https://www.linkedin.com/in/jan-mesarc/" target="_blank" rel="noopener" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
            <a href="https://github.com/jame581" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github"></i></a>
            <a href="https://jame581.itch.io/" target="_blank" rel="noopener" title="itch.io"><i class="fa-brands fa-itch-io"></i></a>
            <a href="https://twitter.com/jame581" target="_blank" rel="noopener" title="Twitter" aria-label="Twitter / X">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
            </a>
            <a href="https://mastodon.gamedev.place/@@jame_581" target="_blank" rel="noopener" title="Mastodon"><i class="fa-brands fa-mastodon"></i></a>
        </div>
        <div class="sb-meta">
            <span>build @BuildInfo.Stamp</span>
            <span><span class="dot">●</span> v2.0</span>
        </div>
    </div>
</aside>

@code {
    private record SectionLink(string Id, string Label, string Idx);

    private static readonly SectionLink[] Sections =
    {
        new("about",      "About",      "01"),
        new("experience", "Experience", "02"),
        new("projects",   "Projects",   "03"),
        new("education",  "Education",  "04"),
        new("skills",     "Skills",     "05"),
        new("interests",  "Interests",  "06"),
    };

    private string activeSection = "about";
    private DotNetObjectReference<NavMenu>? _dotNetRef;

    private bool IsHomeRoute =>
        string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Split('?', '#')[0]);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await StartObserver();
        }
    }

    private async Task StartObserver()
    {
        if (!IsHomeRoute || _dotNetRef is null) return;
        var ids = Sections.Select(s => s.Id).ToArray();
        await JSRuntime.InvokeVoidAsync("PortfolioObserveSections", _dotNetRef, ids);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-attach the section observer when navigating back to home; the
        // section nodes only exist while Index.razor is rendered.
        StateHasChanged();
        if (IsHomeRoute) await StartObserver();
    }

    [JSInvokable]
    public void SetActiveSection(string sectionId)
    {
        if (activeSection == sectionId) return;
        activeSection = sectionId;
        StateHasChanged();
    }

    private void GoSection(string id)
    {
        activeSection = id;
        Nav.NavigateTo($"/#{id}");
    }

    private void GoHome() => GoSection("about");

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        try { await JSRuntime.InvokeVoidAsync("PortfolioDisposeObservers"); }
        catch { /* JS runtime may already be gone during teardown */ }
        _dotNetRef?.Dispose();
    }
}
