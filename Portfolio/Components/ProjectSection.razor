@inject IJSRuntime JS

<section class="sec" id="projects">
    <div class="sec-marker">
        <span class="num">02</span>
        <span>Shipped titles and projects</span>
        <span class="rule"></span>
        <span class="count">@(ShippedTitles.Length + ItchEntries.Length) entries</span>
    </div>

    <h2>Professional</h2>
    <p class="lede" style="margin-top:6px">Commercial titles I have contributed to as a gameplay or systems programmer.</p>

    <div class="project-explorer">
        <div class="project-selector" role="tablist" aria-label="Shipped projects" @onkeydown="HandleProjectKey">
            @for (var i = 0; i < ShippedTitles.Length; i++)
            {
                var projectIndex = i;
                var project = ShippedTitles[projectIndex];
                <button type="button"
                        class="project-option @(projectIndex == _selectedProjectIndex ? "selected" : null)"
                        role="tab"
                        aria-selected="@(projectIndex == _selectedProjectIndex)"
                        aria-controls="selected-project-panel"
                        id="project-tab-@projectIndex"
                        data-project-index="@projectIndex"
                        tabindex="@(projectIndex == _selectedProjectIndex ? 0 : -1)"
                        @onclick="() => SelectProject(projectIndex)">
                    <span class="project-option-index">@((projectIndex + 1).ToString("D2"))</span>
                    <span class="project-option-title">@project.Title</span>
                </button>
            }
        </div>

        <article class="project-panel" id="selected-project-panel" role="tabpanel" aria-labelledby="project-tab-@_selectedProjectIndex" aria-live="polite">
            <div class="project-position">@((_selectedProjectIndex + 1).ToString("D2")) / @ShippedTitles.Length.ToString("D2")</div>
            <div class="project-cover">
                <img src="@SelectedProject.Img" alt="@SelectedProject.Title" loading="lazy" />
                <span class="badge">@SelectedProject.Badge</span>
            </div>
            <div class="project-details">
                <div class="pmeta">
                    <span class="yr">@SelectedProject.Year</span>
                    <span>@SelectedProject.Platforms</span>
                </div>
                <h4>@SelectedProject.Title</h4>
                <p class="desc">@SelectedProject.Desc</p>
                <div class="links">
                    @foreach (var l in SelectedProject.Links)
                    {
                        <a href="@l.Href" target="_blank" rel="noopener">@l.Label ↗</a>
                    }
                </div>
            </div>
        </article>
    </div>

    <h2 style="margin-top:clamp(44px,5vw,64px)">Jams and experiments</h2>
    <p class="lede" style="margin-top:6px">Smaller games and prototypes, most of them made in jams with friends.</p>

    <div class="itch-grid">
        @foreach (var g in ItchEntries)
        {
            <a class="itch-card reveal" href="@g.Href" target="_blank" rel="noopener">
                <div class="top">
                    <h5>@g.Title</h5>
                    <span class="yr">@g.Year</span>
                </div>
                <p>@g.Desc</p>
                <div class="row">
                    <span>@g.Host</span>
                    <span class="play">play ↗</span>
                </div>
            </a>
        }
    </div>
</section>

@code {
    private int _selectedProjectIndex;

    private Shipped SelectedProject => ShippedTitles[_selectedProjectIndex];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("PortfolioBindProjectKeys");
    }

    private void SelectProject(int index)
    {
        _selectedProjectIndex = Math.Clamp(index, 0, ShippedTitles.Length - 1);
    }

    private async Task HandleProjectKey(KeyboardEventArgs e)
    {
        var nextIndex = e.Key switch
        {
            "ArrowUp" or "ArrowLeft" => _selectedProjectIndex - 1,
            "ArrowDown" or "ArrowRight" => _selectedProjectIndex + 1,
            "Home" => 0,
            "End" => ShippedTitles.Length - 1,
            _ => _selectedProjectIndex
        };

        if (nextIndex == _selectedProjectIndex && e.Key is not ("Home" or "End"))
            return;

        SelectProject(nextIndex);
        await JS.InvokeVoidAsync("PortfolioFocusProject", _selectedProjectIndex);
    }

    private record Shipped(string Title, string Year, string Platforms, string Badge, string Img,
                           string Desc, ProjectLink[] Links);
    private record ProjectLink(string Label, string Href);

    private record ItchEntry(string Title, string Year, string Desc, string Href)
