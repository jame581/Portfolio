<section class="sec" id="skills">
    <div class="sec-marker">
        <span class="num">05</span>
        <span>Skills</span>
        <span class="rule"></span>
    </div>

    <p style="margin-top: 0; margin-bottom: 28px; max-width: 60ch; color: var(--fg-dim);">
        Specialized game programmer with <b>10+ years of software engineering</b> experience.
        Primary focus: <b>Unreal Engine (C++)</b> and <b>Godot (C#)</b>. Comfortable across
        backend, cloud and cross-platform stacks when the job calls for it.
    </p>

    @foreach (var block in Blocks)
    {
        <div class="skill-block">
            <div class="label"><span class="num">@block.Num</span>@block.Label</div>
            <div class="skill-list">
                @foreach (var s in block.Items)
                {
                    <span class="chip">
                        @s.Name
                        <span class="level"><i style="width: @($"{s.Level * 20}%");"></i></span>
                    </span>
                }
            </div>
        </div>
    }
</section>

@code {
    private record Skill(string Name, int Level);
    private record SkillBlock(string Num, string Label, Skill[] Items);

    private static readonly SkillBlock[] Blocks =
    {
        new("01", "Languages", new[]
        {
            new Skill("C#", 5),
            new Skill("C++", 4),
            new Skill("TypeScript", 4),
            new Skill("GDScript", 3),
            new Skill("HTML / CSS", 4),
        }),
        new("02", "Game Engines", new[]
        {
            new Skill("Unreal Engine", 5),
            new Skill("Godot", 4),
            new Skill("Replication & Networking", 4),
            new Skill("Gameplay Systems", 5),
            new Skill("UI Implementation", 4),
        }),
        new("03", "Backend & Cloud", new[]
        {
            new Skill(".NET / ASP.NET", 5),
            new Skill("Blazor", 4),
            new Skill("REST APIs", 4),
            new Skill("SQL", 4),
            new Skill("Azure", 3),
            new Skill("Docker", 3),
        }),
        new("04", "Cross-Platform", new[]
        {
            new Skill(".NET MAUI", 4),
            new Skill("Xamarin Forms", 4),
            new Skill("WPF", 3),
        }),
    };
}
