@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@implements IAsyncDisposable
@using Portfolio.Services

<aside class="sidebar">
    <div class="sb-brand-row">
        <a class="sb-brand" href="/#about" @onclick="GoHome" @onclick:preventDefault>
            <img src="assets/profile1.jpg" alt="Jan Mesarc" />
            <div>
                <div class="sb-name">Jan Mesarc</div>
                <div class="sb-role">Game developer</div>
            </div>
        </a>
        <button type="button"
                @ref="_drawerToggle"
                class="sb-toggle"
                aria-label="@(_drawerOpen ? "Close menu" : "Open menu")"
                aria-expanded="@_drawerOpen.ToString().ToLower()"
                aria-controls="sb-navigation"
                @onclick="ToggleDrawer">
            <span class="sb-toggle-label">@(_drawerOpen ? "Close" : "Menu")</span>
            <span class="sb-toggle-icon" aria-hidden="true">@(_drawerOpen ? "✕" : "☰")</span>
        </button>
    </div>

    <div id="sb-navigation"
         class="sb-drawer @(_drawerOpen ? "open" : "")">
        <div class="sb-label">Sections</div>
        <nav class="sb-nav">
            @foreach (var item in Sections)
            {
                <a href="/#@item.Id"
                   class="@(IsHomeRoute && activeSection == item.Id ? "active" : null)"
                   aria-current="@(IsHomeRoute && activeSection == item.Id ? "location" : null)"
                   @onclick="() => GoSection(item.Id)" @onclick:preventDefault>
                    <span class="idx">@item.Idx</span>
                    <span>@item.Label</span>
                    <span class="arrow">→</span>
                </a>
            }
        </nav>

        <div class="sb-label">More</div>
        <nav class="sb-nav">
            <NavLink href="fetchgithubdata" Match="NavLinkMatch.All" ActiveClass="active"
                     @onclick="CloseDrawer">
                <span class="idx">07</span>
                <span>Public repositories</span>
                <span class="arrow">→</span>
            </NavLink>
        </nav>

        <div class="sb-foot">
            <div class="sb-socials">
