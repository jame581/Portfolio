<section class="sec" id="interests">
    <div class="sec-marker">
        <span class="num">06</span>
        <span>Interests</span>
        <span class="rule"></span>
    </div>

    <p class="lede" style="margin-bottom:26px">
        Away from a keyboard I am usually doing sport, travelling, or on a snowboard.
        New tech and new techniques are a constant either way.
    </p>

    @* Track count (2, or 4 above 760px) must divide the item count, or the grid
       background shows through the empty cells. *@
    <div class="interests-grid">
        @foreach (var it in Entries)
        {
            <div class="interest">
                <div class="k">@it.Kind</div>
                <div class="v">@it.Value</div>
            </div>
        }
    </div>
</section>

@code {
    private record Entry(string Kind, string Value);

    private static readonly Entry[] Entries =
    {
        new("Sport",  "Historical fencing (HEMA)"),
        new("Sport",  "Soccer and billiards"),
        new("Travel", "New places and cultures"),
        new("Winter", "Snowboarding"),
    };
}
