@inject IJSRuntime JS

<section class="sec" id="projects">
    <div class="sec-marker">
        <span class="num">02</span>
        <span>Shipped titles and projects</span>
        <span class="rule"></span>
        <span class="count">@(ShippedTitles.Length + ItchEntries.Length) entries</span>
    </div>

    <h2>Professional</h2>
    <p class="lede" style="margin-top:6px">Commercial titles I have contributed to as a gameplay or systems programmer.</p>

    <div class="strip-controls">
        <span class="count">@ShippedTitles.Length titles, scroll sideways</span>
        <div class="nav">
            <button type="button" aria-label="Previous" @onclick="() => Scroll(-1)">‹</button>
            <button type="button" aria-label="Next" @onclick="() => Scroll(1)">›</button>
        </div>
    </div>

    <div class="strip-wrap">
        <div class="strip" @ref="stripEl">
            @foreach (var p in ShippedTitles)
            {
                <article class="proj">
                    <div class="cover">
                        <img src="@p.Img" alt="@p.Title" loading="lazy" />
                        <span class="badge">@p.Badge</span>
                    </div>
                    <div class="body">
                        <div class="pmeta">
                            <span class="yr">@p.Year</span>
                            <span>@p.Platforms</span>
                        </div>
                        <h4>@p.Title</h4>
                        <p class="desc">@p.Desc</p>
                        <div class="links">
                            @foreach (var l in p.Links)
                            {
                                <a href="@l.Href" target="_blank" rel="noopener">@l.Label ↗</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>

    <h2 style="margin-top:clamp(44px,5vw,64px)">Jams and experiments</h2>
    <p class="lede" style="margin-top:6px">Smaller games and prototypes, most of them made in jams with friends.</p>

    <div class="itch-grid">
        @foreach (var g in ItchEntries)
        {
            <a class="itch-card reveal" href="@g.Href" target="_blank" rel="noopener">
                <div class="top">
                    <h5>@g.Title</h5>
                    <span class="yr">@g.Year</span>
                </div>
                <p>@g.Desc</p>
                <div class="row">
                    <span>@g.Host</span>
                    <span class="play">play ↗</span>
                </div>
            </a>
        }
    </div>
</section>

@code {
    private ElementReference stripEl;

    private async Task Scroll(int dir) =>
        await JS.InvokeVoidAsync("PortfolioScrollStrip", stripEl, dir);

